-            )
-        } else {
-            format!("Up to date (cmux-cua {}).", state.current_version)
-        };
-
-        let structured = serde_json::to_value(&state)
-            .unwrap_or_else(|_| serde_json::json!({}));
-
-        ToolResult::text(summary).with_structured(structured)
-    }
-}
